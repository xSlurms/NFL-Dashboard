{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "netlify-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/netlify-cli/bin/run.js", "dev", "--offline", "--no-open"],
      "port": 8888
    },
    {
      "name": "vite-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "preview", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
